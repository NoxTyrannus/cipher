  {
    "id": "text.grep",
    "name": "Grep Text",
    "type": "function",
    "description": "在文件中搜索文本模式；path 为目录且 recursive=true 时递归搜索目录内文件",
    "schema_in": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "recursive": {
          "type": "boolean",
          "description": "path 为目录时必须为 true，递归搜索目录内所有文件"
        }
      },
      "required": [
        "pattern",
        "path"
      ]
    },
    "schema_out": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "matches"
      ]
    },
    "executor": "builtin:text.grep",
    "version": "1.0.0",
    "enabled": true,
    "partition": "system"
  },
