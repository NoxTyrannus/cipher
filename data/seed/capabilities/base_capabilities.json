  {
    "id": "capability.import",
    "name": "Import Capability",
    "type": "function",
    "description": "原子化导入用户定义的能力定义（base/composite/usage），用于把 skill/插件描述转化为 cipher 自身能力。executor 仅允许已知 builtin。",
    "schema_in": {
      "type": "object",
      "properties": {
        "base_capabilities": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "composite_capabilities": {
          "type": "array",
          "items": {
            "type": "object"
          }
