    {
      "id": "capability.self-register",
      "name": "Self Register Capability",
      "description": "从能力定义到落库验证的注册闭环：import → 独立回读 → 台账 imported → 台账 verified。连坐门：gate 探针（usage 行）仅在 capability_id 于注册表（base/composite，enabled 且未 tombstone）真实存在时可导入；空回读使整条失败——verified 不可凭回执落账。",
      "schema_in": {
        "type": "object",
        "properties": {
          "base_capabilities": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "capability.import 的 base 定义数组（原样透传给 import 节点）"
          },
          "composite_capabilities": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "capability.import 的 composite 定义数组"
          },
          "usage_methods": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "capability.import 的 usage_method 定义数组"
          },
          "grant_to_agent": {
            "type": "string",
            "description": "可选：导入后授权目标 agent（capability.import 原语义）"
          },
          "capability_id": {
            "type": "string",
            "description": "注册后要回读验证的能力 id；必须与定义中真正注册的 id 一致，否则 gate 探针连坐整条失败"
          },
          "item": {
            "type": "string",
            "description": "台账条目描述（deliverable_ledger.item）"
          },
          "owner_agent": {
            "type": "string",
            "description": "可选：台账归属 agent；未提供时台账不落 owner"
          }
        },
        "required": [
          "capability_id",
          "item"
        ]
      },
      "schema_out": {
        "type": "object",
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "steps": {
            "type": "array"
          },
          "final": {}
        },
        "required": [
          "capability_id",
          "steps",
          "final"
        ]
      },
      "executor": "dag",
      "dag": [
        {
          "id": "register",
          "base_capability": "capability.import",
          "depends_on": []
        },
        {
          "id": "verify",
          "base_capability": "db.query",
          "depends_on": [
            "register"
          ],
          "args": {
            "table": "base_capability",
            "where": "id = '$input.capability_id'"
          }
        },
        {
          "id": "gate",
          "base_capability": "capability.import",
          "depends_on": [
            "register"
          ],
          "args": {
            "base_capabilities": [],
            "composite_capabilities": [],
            "grant_to_agent": "",
            "usage_methods": [
              {
                "id": "selfregister.probe.$input.capability_id",
                "capability_id": "$input.capability_id",
                "name": "Self Register Verify Probe",
                "prompt": "capability.self-register 的连坐门探针行：仅当 capability_id 在注册表（base 或 composite，enabled 且未 tombstone）真实存在时，本 usage 行才能通过 capability.import 的 capability_id 存在性校验；不存在则 gate 节点失败，整条 self-register 失败，verified 不落账。",
                "examples": null,
                "metadata": {
                  "partition": "factory",
                  "probe": true
                }
              }
            ]
          }
        },
        {
          "id": "ledger_imported",
          "base_capability": "ledger.write",
          "depends_on": [
            "verify",
            "gate"
          ],
          "args": {
            "item": "$input.item",
            "state": "imported",
            "evidence_refs": [
              "import:${register.success}",
              "rows:${verify.rows}"
            ]
          }
        },
        {
          "id": "ledger_verified",
          "base_capability": "ledger.write",
          "depends_on": [
            "ledger_imported"
          ],
          "args": {
            "id": "${ledger_imported}.id",
            "item": "$input.item",
            "state": "verified",
            "evidence_refs": [
              "rows:${verify.rows}",
              "gate:${gate.success}"
            ]
          }
        }
      ],
      "version": "1.0.0",
      "enabled": true,
      "partition": "factory",
      "metadata": {
        "partition": "factory"
      }
    }
  ]
}