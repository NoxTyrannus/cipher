  {
    "id": "file.copy",
    "name": "Copy File",
    "description": "在工作区内复制文件（原子能力组合示例）",
    "schema_in": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "schema_out": {
      "type": "object",
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "steps": {
          "type": "array"
        },
        "final": {}
      },
      "required": [
        "capability_id",
        "steps",
        "final"
      ]
    },
    "executor": "dag",
    "dag": [
      {
        "id": "read",
        "base_capability": "file.read",
        "args": {
          "path": "$input.from"
        },
        "depends_on": []
      },
      {
        "id": "write",
        "base_capability": "file.write",
        "args": {
          "path": "$input.to",
          "content": "${read}.content"
        },
        "depends_on": [
          "read"
        ]
      }
    ],
    "version": "1.0.0",
    "enabled": true,
    "partition": "system"
  },
  {
    "id": "log.analyze",
    "name": "Log Analyze",
    "description": "日志分析分子：读取->搜索->写入报告",
    "schema_in": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "pattern",
        "output"
      ]
    },
    "schema_out": {
      "type": "object",
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "steps": {
          "type": "array"
        },
        "final": {}
      },
      "required": [
        "capability_id",
        "steps",
        "final"
      ]
    },
    "executor": "dag",
    "dag": [
      {
        "id": "read",
        "base_capability": "file.read",
        "args": {
          "path": "$input.path"
        },
        "depends_on": []
      },
      {
        "id": "grep",
        "base_capability": "text.grep",
        "args": {
          "path": "$input.path",
          "pattern": "$input.pattern"
        },
        "depends_on": []
      },
      {
        "id": "write",
        "base_capability": "file.write",
        "args": {
          "path": "$input.output",
          "content": "${grep}.matches"
        },
        "depends_on": [
          "grep"
        ]
      }
    ],
    "version": "1.0.0",
    "enabled": true,
    "partition": "system"
  },
